Algoritmo basic_calc 
	//declare variables or constants
	Definir num1, num2, add, subs, mult, div Como Entero
	//assign or intialize variables or constants
	num1<-10
	num2<-5
	add<-0
	subs<-0
	mul<-0
	div<-0
	//Inputs 
	num1<-10
	num2<-5
	//Proceso 
	add<-num1+num2
	subs<-num1-num2
	mult<-num1*num2
	div<-num1/num2
	//outputs
	Escribir "the addition is:", add
	Escribir "the subtraction is:", subs
	Escribir "the multiplication is:", mult
	Escribir "the divisionis:", div
FinAlgoritmo


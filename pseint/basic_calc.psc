Algoritmo basic_calc 
	//declare variables or constants
	Definir num1, num2, add, subs, mult Como Entero
	Definir div Como Real
	//assign or intialize variables or constants
	num1<-10
	num2<-5..PPJ
	mul<-0
	div<-0
	//Inputs 
	Escribir "please, enter first number: "
	Leer num1
	Escribir "please, enter second number: "
	Leer num2
	//Proceso 
	add<-num1+num2
	subs<-num1-num2
	mult<-num1*num2
	div<-num1/num2
	//outputs
	Escribir "the addition is:", add
	Escribir "the subtraction is:", subs
	Escribir "the multiplication is:", mult
	Escribir "the divisionis:", div
FinAlgoritmo

